				TweenService:Create(binaryParticle, TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, -70, 0.5, 0), TextTransparency = 1}):Play()
