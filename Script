		local uigradient = Instance.new("UIGradient")
		uigradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.20, Color3.fromRGB(255, 127, 0)),
			ColorSequenceKeypoint.new(0.40, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(0.60, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(0.80, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(1.00, Color3.fromRGB(148, 0, 211))
		})
		uigradient.Parent = uiStroke

		local jStroke = jollyButton:FindFirstChildOfClass("UIStroke")
		if jStroke then
			jStroke.Color = Color3.fromRGB(255, 255, 255)
			local jGrad = uigradient:Clone()
			jGrad.Parent = jStroke
		end

		task.spawn(function()
			while triggerButton and triggerButton.Parent do
				uigradient.Rotation = (uigradient.Rotation + 2) % 360
				RunService.RenderStepped:Wait()
			end
		end)

		local musicIcon = Instance.new("TextLabel")
		musicIcon.Size = UDim2.new(1, 0, 1, 0)
		musicIcon.BackgroundTransparency = 1
		musicIcon.Text = "🎵"
		musicIcon.TextSize = 42
		musicIcon.Parent = triggerButton

		local dragging = false
		local dragInput, dragStart, startPos
		local hasMoved = false

		triggerButton.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = triggerButton.Position
				hasMoved = false
				
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)

		triggerButton.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if input == dragInput and dragging then
				local delta = input.Position - dragStart
				if delta.Magnitude > 5 then
					hasMoved = true
				end
				triggerButton.Position = UDim2.new(
					startPos.X.Scale, 
					startPos.X.Offset + delta.X, 
					startPos.Y.Scale, 
					startPos.Y.Offset + delta.Y
				)
			end
		end)

		triggerButton.MouseButton1Click:Connect(function()
			if hasMoved then return end

			triggerButton:Destroy()

			if introEnabled then
				runCinematicIntro(function()
					mainPanel.Visible = true
				end)
			else
				mainPanel.Visible = true
			end
		end)
	end

	createTriggerButton()

	closeButton.MouseButton1Click:Connect(function()
		mainPanel.Visible = false
		createTriggerButton()
	end)

