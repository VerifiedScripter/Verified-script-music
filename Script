			TweenService:Create(centerSquare, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
			TweenService:Create(csStroke, TweenInfo.new(0.4), {Transparency = 1}):Play()
			TweenService:Create(csMusicIcon, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
			TweenService:Create(subtitleLabel, TweenInfo.new(0.4), {TextTransparency = 1}):Play()

			task.wait(0.4)
			cinematicHolder:Destroy()

			if onComplete then
				onComplete()
			end
		end)
