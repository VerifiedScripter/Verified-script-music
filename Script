				decodeStream.TextSize = 14
				decodeStream.Font = Enum.Font.Code
				decodeStream.BackgroundTransparency = 1
				decodeStream.Parent = cinematicHolder
				TweenService:Create(decodeStream, TweenInfo.new(0.3), {Position = UDim2.new(0.5, -150, 0.5, 90), TextTransparency = 1}):Play()
				task.delay(0.3, function() decodeStream:Destroy() end)
				task.wait(0.025)
			end

			local targetText = "verified script music"
			for i = 1, #targetText do
				subtitleLabel.Text = string.sub(targetText, 1, i)
				task.wait(0.03)
			end

			TweenService:Create(centerSquare, TweenInfo.new(0.3), {BackgroundTransparency = 0}):Play()
			TweenService:Create(csStroke, TweenInfo.new(0.3), {Transparency = 0}):Play()
			TweenService:Create(csMusicIcon, TweenInfo.new(0.3), {TextTransparency = 0}):Play()

