		subtitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		subtitleLabel.TextSize = 22
		subtitleLabel.Font = Enum.Font.Code
		subtitleLabel.Parent = cinematicHolder

		task.spawn(function()
			for i = 1, 50 do
				local binaryParticle = Instance.new("TextLabel")
				binaryParticle.Size = UDim2.new(0, 120, 0, 20)
				binaryParticle.Text = math.random(0,1) .. math.random(0,1) .. math.random(0,1) .. math.random(0,1) .. math.random(0,1) .. math.random(0,1)
				binaryParticle.TextColor3 = Color3.fromRGB(0, 255, 128)
				binaryParticle.TextSize = 18
				binaryParticle.Font = Enum.Font.Code
				binaryParticle.BackgroundTransparency = 1
				
				local side = math.random(1, 4)
				if side == 1 then
					binaryParticle.Position = UDim2.new(0, -100, math.random(0.2, 0.8), 0)
				elseif side == 2 then
					binaryParticle.Position = UDim2.new(1, 100, math.random(0.2, 0.8), 0)
				elseif side == 3 then
