		csMusicIcon.Parent = centerSquare

		local subtitleLabel = Instance.new("TextLabel")
		subtitleLabel.Size = UDim2.new(0, 450, 0, 50)
		subtitleLabel.Position = UDim2.new(0.5, -225, 0.5, 90)
		subtitleLabel.BackgroundTransparency = 1
