local function createBinaryParticle(spreadOut)
	if not bgBinaryFolder.Parent then return end
	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(0, 100, 0, 30)
	
	local startX = math.random(0, 100) / 100
	local startY = math.random(0, 100) / 100
	textLabel.Position = UDim2.new(startX, 0, startY, 0)
	
	textLabel.BackgroundTransparency = 1
	textLabel.TextColor3 = Color3.fromRGB(0, 255, 65) -- Matrix green
	textLabel.TextTransparency = 0.3
	textLabel.TextSize = math.random(14, 24)
	textLabel.Font = Enum.Font.Code
	textLabel.Text = math.random(0, 1) == 1 and "1010101" or "0101010"
	textLabel.Parent = bgBinaryFolder
	
	local targetPos = textLabel.Position
	if spreadOut then
		targetPos = UDim2.new(startX + (math.random(-50, 50)/100), 0, startY + (math.random(-50, 50)/100), 0)
	end
	
	TweenService:Create(textLabel, TweenInfo.new(1.5), {
		Position = targetPos,
		TextTransparency = 1
	}):Play()
	
	task.delay(1.5, function()
		if textLabel then textLabel:Destroy() end
	end)
end

