-- Run Intro Sequence
task.spawn(function()
	local function typeText(message, delayTime)
		introText.Text = ""
		for i = 1, #message do
			introText.Text = string.sub(message, 1, i)
			task.wait(delayTime or 0.04)
		end
	end

	task.wait(0.5)
	typeText("verified script: surfer", 0.04)
	task.wait(1.0)
	
	introText.Text = ""
	introImage.Image = "rbxassetid://4845733115"
	TweenService:Create(introImage, TweenInfo.new(0.5), {ImageTransparency = 0}):Play()
	task.wait(1.8)
	
	local fadeOutImg = TweenService:Create(introImage, TweenInfo.new(0.5), {ImageTransparency = 1})
	fadeOutImg:Play()
	fadeOutImg.Completed:Wait()
	
	introImage.Image = "rbxassetid://139619959097679"
	TweenService:Create(introImage, TweenInfo.new(0.5), {ImageTransparency = 0}):Play()
	task.wait(1.8)
	
	local tweenInfo = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(introImage, tweenInfo, {ImageTransparency = 1}):Play()
	local fadeBg = TweenService:Create(binaryBg, tweenInfo, {TextTransparency = 1})
	fadeBg:Play()
	
	fadeBg.Completed:Wait()
	introFrame:Destroy()
end)

------------------------------------------------------------------
-- DYNAMIC TURNING & DRIFTING ICE MOMENTUM LOOP (RenderStepped)
------------------------------------------------------------------
RunService.RenderStepped:Connect(function(dt)
	local character = LocalPlayer.Character
	if not character then return end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	
	if not hrp or not humanoid then return end
	
	if isIcyActive and humanoid.FloorMaterial ~= Enum.Material.Air then
		local moveDir = humanoid.MoveDirection
		
		if moveDir.Magnitude > 0 then
			-- Map move direction relative to camera facing/turning layout
			local targetVel = moveDir * humanoid.WalkSpeed * 1.8
			-- Faster response blending when turning steering angles actively
			slideVelocity = slideVelocity:Lerp(targetVel, math.clamp(dt * 10, 0, 1))
		else
			-- Long continuous drift/glide when keys are released
			slideVelocity = slideVelocity:Lerp(Vector3.new(0, 0, 0), math.clamp(dt * 0.35, 0, 1))
		end
		
		hrp.AssemblyLinearVelocity = Vector3.new(slideVelocity.X, hrp.AssemblyLinearVelocity.Y, slideVelocity.Z)
	else
		slideVelocity = Vector3.new(0, 0, 0)
	end
end)
