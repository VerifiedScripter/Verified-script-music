--------------------------------------------------------------------------------
-- DRAGGABLE GUI FUNCTIONALITY (Touch & Mouse Support)
--------------------------------------------------------------------------------
local draggingGui = false
local dragStartPos = nil
local frameStartPos = nil

mainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		local mousePos = input.Position
		draggingGui = true
		dragStartPos = mousePos
		frameStartPos = mainFrame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				draggingGui = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if draggingGui and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStartPos
		mainFrame.Position = UDim2.new(
			frameStartPos.X.Scale,
			frameStartPos.X.Offset + delta.X,
			frameStartPos.Y.Scale,
			frameStartPos.Y.Offset + delta.Y
		)
	end
end)

--------------------------------------------------------------------------------
-- SENSITIVITY SLIDER LOGIC & MOBILE OVERRIDE
--------------------------------------------------------------------------------
local currentSensitivity = DEFAULT_SENSITIVITY
local draggingSlider = false

local function setSensitivityValue(val)
	currentSensitivity = math.clamp(val, MIN_SENSITIVITY, MAX_SENSITIVITY)
	local alpha = (currentSensitivity - MIN_SENSITIVITY) / (MAX_SENSITIVITY - MIN_SENSITIVITY)

	sliderFill.Size = UDim2.new(alpha, 0, 1, 0)
	sliderKnob.Position = UDim2.new(alpha, 0, 0.5, 0)
	sensitivityLabel.Text = "Sensitivity: " .. string.format("%.2f", currentSensitivity)

	local success, userSettings = pcall(function()
		return UserSettings():GetService("UserGameSettings")
	end)
	if success and userSettings then
		pcall(function()
			userSettings.MouseSensitivity = currentSensitivity / MAX_SENSITIVITY
		end)
	end
end

local function updateSlider(inputPositionX)
	local trackAbsolutePos = sliderTrack.AbsolutePosition.X
	local trackAbsoluteSize = sliderTrack.AbsoluteSize.X
	local relativeX = math.clamp(inputPositionX - trackAbsolutePos, 0, trackAbsoluteSize)
	local alpha = relativeX / trackAbsoluteSize

	local calculatedSens = MIN_SENSITIVITY + alpha * (MAX_SENSITIVITY - MIN_SENSITIVITY)
	setSensitivityValue(calculatedSens)
end

sliderKnob.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingSlider = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingSlider = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		updateSlider(input.Position.X)
	end
end)

-- Mobile & Custom Camera Pan Support via InputChanged delta manipulation
UserInputService.InputChanged:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
		if input.UserInputState == Enum.UserInputState.Change then
			local delta = input.Delta
			local scaleFactor = (currentSensitivity / DEFAULT_SENSITIVITY) - 1.0
			if math.abs(scaleFactor) > 0.01 then
				camera.CFrame = camera.CFrame * CFrame.Angles(
					-math.rad(delta.Y * 0.15 * scaleFactor),
					-math.rad(delta.X * 0.15 * scaleFactor),
					0
				)
			end
		end
	end
end)

--------------------------------------------------------------------------------
-- BUTTON ACTIONS: RESET, 360 SPIN, & SPIN BOTH
--------------------------------------------------------------------------------
resetButton.MouseButton1Click:Connect(function()
	setSensitivityValue(DEFAULT_SENSITIVITY)
end)

local isSpinning360 = false
spin360Button.MouseButton1Click:Connect(function()
	if isSpinning360 then return end
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	local rootPart = character.HumanoidRootPart

	isSpinning360 = true
	local totalRotated = 0
	local targetRotation = math.rad(360)
	local baseSpeed = 10 -- Base rotation speed
	
	local connection
	connection = RunService.RenderStepped:Connect(function(dt)
		local speed = baseSpeed * currentSensitivity
		local step = speed * dt
		
		totalRotated = totalRotated + step
		if totalRotated >= targetRotation then
			local remainder = totalRotated - targetRotation
			step = step - remainder
			rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, step, 0)
			
			connection:Disconnect()
			isSpinning360 = false
		else
			rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, step, 0)
		end
	end)
end)

local isSpinningBoth = false
spinBothButton.MouseButton1Click:Connect(function()
	if isSpinningBoth then return end
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	local rootPart = character.HumanoidRootPart

	isSpinningBoth = true
	local baseSpeed = 8 -- Speed factor
	
	local connection
	connection = RunService.RenderStepped:Connect(function(dt)
		local speed = baseSpeed * currentSensitivity
		local step = speed * dt
		
		-- Rotate Character
		rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, step, 0)
		-- Rotate Camera in sync around its focus point
		camera.CFrame = camera.CFrame * CFrame.Angles(0, step, 0)
	end)

	-- Let it spin for 2 seconds then stop automatically
	task.delay(2, function()
		if connection then
			connection:Disconnect()
		end
		isSpinningBoth = false
	end)
end)
